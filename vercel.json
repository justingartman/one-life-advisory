{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/services-and-fees",
      "permanent": true
    },
    {
      "source": "/blog/topics/tax-aware-planning",
      "destination": "/blog/topics/forward-looking-tax-planning",
      "permanent": true
    },
    {
      "source": "/yt/:code/c",
      "destination": "/schedule?utm_source=youtube&utm_medium=pinned_comment&utm_campaign=:code",
      "permanent": false
    },
    {
      "source": "/yt/:code/p",
      "destination": "/schedule?utm_source=podcast&utm_medium=episode_notes&utm_campaign=:code",
      "permanent": false
    },
    {
      "source": "/yt/:code/b",
      "destination": "/schedule?utm_source=blog&utm_medium=article&utm_campaign=:code",
      "permanent": false
    },
    {
      "source": "/yt/:code",
      "destination": "/schedule?utm_source=youtube&utm_medium=video_description&utm_campaign=:code",
      "permanent": false
    }
  ]
}
